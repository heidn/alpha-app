# Copy to .env.local (gitignored). `npx convex dev` writes CONVEX_DEPLOYMENT + VITE_CONVEX_URL for you.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Set these in YOUR Convex dev deployment (dashboard or `npx convex env set`), NOT here:
#   CLERK_FRONTEND_API_URL   e.g. https://your-app.clerk.accounts.dev
