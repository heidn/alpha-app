{
  "name": "alpha-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @alpha/web --",
    "dev:backend": "convex dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "build": "npm run build -w @alpha/web",
    "typecheck": "npm run typecheck -w @alpha/web && npm --prefix apps/mobile run typecheck",
    "lint": "oxlint apps convex",
    "setup:mobile": "npm --prefix apps/mobile ci"
  },
  "dependencies": {
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
