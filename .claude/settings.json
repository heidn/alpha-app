{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.sh\"" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(\"/c/Program Files/GitHub CLI/gh.exe\" pr merge *)"
    ],
    "deny": [
      "Bash(npx convex deploy*)",
      "Bash(npm audit fix --force*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
